# Copy these into the Dokploy "Environment" tab of the compose service.
GHCR_OWNER=your-github-user
BATVISION_TAG=latest
MEDIA_PATH=/srv/media
DATA_PATH=/srv/batvision/data
CACHE_PATH=/srv/batvision/cache
PUID=1000
PGID=1000
# TMDB "API Read Access Token" (themoviedb.org > Settings > API). Without it: no metadata.
TMDB_TOKEN=
DEFAULT_LANGUAGE=fr-FR
