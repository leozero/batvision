    "expo-device": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-intent-launcher": "~58.0.0",
    "expo-keep-awake": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-localization": "~58.0.0",
    "expo-navigation-bar": "~58.0.0",
    "expo-network": "~58.0.0",
