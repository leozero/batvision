{
  "expo": {
    "name": "BatVision",
    "slug": "batvision",
    "version": "0.6.0",
    "scheme": "batvision",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090c",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090c"
    },
    "ios": {
      "bundleIdentifier": "fr.batvision.ios",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "audio"],
        "BGTaskSchedulerPermittedIdentifiers": ["fr.batvision.ios.sync"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "BatVision connects to your media server on this network."
      }
    },
    "android": {
      "package": "fr.batvision.android",
      "adaptiveIcon": {
        "backgroundColor": "#09090c",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-video",
        {
          "enableAndroidPictureInPicture": true,
          "enableNotificationControls": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
